# SpiceXplorer container configuration.
#   cp .env.example .env   and edit as needed, then:  docker compose up --build
# docker compose loads this file automatically. Every value has a sane default,
# so an empty/absent .env still gives a working stack.

# --- Mounts -------------------------------------------------------------------
# Host directory mounted at /work inside the backend (your projects + outputs).
# Use an absolute path to point at a different drive, e.g. /mnt/data/spicex.
WORKDIR=./work

# --- File ownership (Linux) ---------------------------------------------------
# Match the container's runtime user to your host user so files written to
# WORKDIR are yours, not root's. On Linux set these to your own ids:
#   echo "UID=$(id -u)"; echo "GID=$(id -g)"
# (Harmless on macOS/Windows, where Docker remaps ownership automatically.)
UID=1000
GID=1000

# --- Ports (host side) --------------------------------------------------------
FRONTEND_PORT=4000
BACKEND_PORT=8000

# --- OSDI compact models (architecture) ---------------------------------------
# How the backend image gets the ngspice OSDI device models:
#   compile (default) — built from the vendored Verilog-A for YOUR host arch via
#                       openvaf. Native on x86-64 AND arm64 (incl. Apple silicon),
#                       no emulation. Heavier first build (Rust + LLVM toolchain).
#   vendor            — reuse the prebuilt x86-64 OSDI (fast, no openvaf), but
#                       x86-64 only. On Apple silicon use it under emulation:
#                       OSDI_MODE=vendor DOCKER_DEFAULT_PLATFORM=linux/amd64 docker compose up --build
OSDI_MODE=compile

# --- Logging ------------------------------------------------------------------
# DEBUG / INFO / WARNING / ERROR / CRITICAL  (spicexplorer library console level)
LOG_LEVEL=INFO

# --- LLM agents (optional, for later) -----------------------------------------
# Flip to true to install the `agents` dependency extra into the backend image
# (requires a rebuild: docker compose build backend).
INSTALL_AGENTS=false

# API keys for the (future) LLM-agent layer. Uncomment and fill in to pass them
# into the backend container. Leave commented/blank to omit. These are injected
# at runtime only — they are never written into the built image.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
